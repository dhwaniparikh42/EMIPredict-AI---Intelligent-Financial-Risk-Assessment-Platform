# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is git-ignored. NEVER commit it or paste the token in chat.
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-username>/<dagshub-repo>.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-username>
MLFLOW_TRACKING_PASSWORD=<your-dagshub-access-token>
