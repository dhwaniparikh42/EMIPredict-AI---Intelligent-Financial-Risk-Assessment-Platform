# data is large -> never commit it, share via Drive / DVC / Git LFS instead
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# env / caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# experiment tracking (local MLflow store: heavy, regenerate with train.py)
mlruns/
mlartifacts/
mlflow.db
mlflow_server/
*.pkl

# models: only the two small deployable "best" models are committed
models/*
!models/.gitkeep
!models/best_classifier.joblib
!models/best_regressor.joblib

.env
